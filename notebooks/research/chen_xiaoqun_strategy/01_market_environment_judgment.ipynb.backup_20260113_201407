        "    factors = []\n",
        "    \n",
        "    # 1. 主要依据：涨停家数（权重最高）\n",
        "    if limit_up_count < 10:\n",
        "        cycle = \"退潮期\"\n",
        "        position = \"0%\"\n",
        "        strategy = \"空仓等待\"\n",
        "        confidence_score += 3\n",
        "        factors.append(f\"涨停家数{limit_up_count}只（<10只，退潮期特征）\")\n",
        "    elif limit_up_count < 30:\n",
        "        cycle = \"启动期\"\n",
        "        position = \"10%\"\n",
        "        strategy = \"首板卡位术（10%试错仓）\"\n",
        "        confidence_score += 3\n",
        "        factors.append(f\"涨停家数{limit_up_count}只（10-30只，启动期特征）\")\n",
        "    elif limit_up_count < 60:\n",
        "        cycle = \"加速期\"\n",
        "        position = \"50%+\"\n",
        "        strategy = \"龙头战法（重仓持有）\"\n",
        "        confidence_score += 3\n",
        "        factors.append(f\"涨停家数{limit_up_count}只（30-60只，加速期特征）\")\n",
        "    else:\n",
        "        cycle = \"过热期\"\n",
        "        position = \"30-50%\"\n",
        "        strategy = \"逐步减仓\"\n",
        "        confidence_score += 3\n",
        "        factors.append(f\"涨停家数{limit_up_count}只（>60只，过热期特征）\")\n",
        "    \n",
        "    # 2. 连板高度验证（权重中等）\n",
        "    if cycle == \"退潮期\" and max_height < 3:\n",
        "        confidence_score += 1\n",
        "        factors.append(f\"连板高度{max_height}板（<3板，符合退潮期）\")\n",
        "    elif cycle == \"启动期\" and 3 <= max_height <= 4:\n",
        "        confidence_score += 1\n",
        "        factors.append(f\"连板高度{max_height}板（3-4板，符合启动期）\")\n",
        "    elif cycle == \"加速期\" and 4 <= max_height <= 6:\n",
        "        confidence_score += 1\n",
        "        factors.append(f\"连板高度{max_height}板（4-6板，符合加速期）\")\n",
        "    elif cycle == \"过热期\" and max_height > 7:\n",
        "        confidence_score += 1\n",
        "        factors.append(f\"连板高度{max_height}板（>7板，符合过热期）\")\n",
        "    elif cycle == \"启动期\" and max_height >= 3 and limit_up_count >= 25:\n",
        "        # 有3板以上且涨停数接近30，可能进入加速期\n",
        "        cycle = \"加速期\"\n",
        "        position = \"50%+\"\n",
        "        strategy = \"龙头战法（重仓持有）\"\n",
        "        confidence_score += 2\n",
        "        factors.append(f\"连板高度{max_height}板+涨停数{limit_up_count}只（接近加速期）\")\n",
        "    \n",
        "    # 3. 炸板率验证（权重中等）\n",
        "    if cycle == \"退潮期\" and zhaban_rate > 40:\n",
        "        confidence_score += 1\n",
        "        factors.append(f\"炸板率{zhaban_rate:.1f}%（>40%，确认退潮期）\")\n",
        "    elif cycle == \"启动期\" and 10 <= zhaban_rate <= 20:\n",
        "        confidence_score += 1\n",
        "        factors.append(f\"炸板率{zhaban_rate:.1f}%（10-20%，符合启动期）\")\n",
        "    elif cycle == \"加速期\" and 15 <= zhaban_rate <= 25:\n",
        "        confidence_score += 1\n",
        "        factors.append(f\"炸板率{zhaban_rate:.1f}%（15-25%，符合加速期）\")\n",
        "    elif cycle == \"过热期\" and zhaban_rate > 30:\n",
        "        confidence_score += 1\n",
        "        factors.append(f\"炸板率{zhaban_rate:.1f}%（>30%，符合过热期）\")\n",
        "    elif cycle == \"加速期\" and zhaban_rate > 30:\n",
        "        # 炸板率过高，可能进入过热期\n",
        "        cycle = \"过热期\"\n",
        "        position = \"30-50%\"\n",
        "        strategy = \"逐步减仓\"\n",
        "        confidence_score += 1\n",
        "        factors.append(f\"炸板率{zhaban_rate:.1f}%（>30%，可能过热）\")\n",
        "    \n",
        "    # 4. 资金流向验证（权重较低）\n",
        "    if avg_inflow > 0.5 and cycle in [\"启动期\", \"加速期\"]:\n",
        "        confidence_score += 0.5\n",
        "        factors.append(f\"资金净流入{avg_inflow:.2f}%（支持上涨周期）\")\n",
        "    elif avg_inflow < -0.5 and cycle == \"退潮期\":\n",
        "        confidence_score += 0.5\n",
        "        factors.append(f\"资金净流出{avg_inflow:.2f}%（确认退潮期）\")\n",
        "    elif avg_inflow < -0.5 and cycle != \"退潮期\":\n",
        "        confidence_score -= 0.5\n",
        "        factors.append(f\"⚠️  资金净流出{avg_inflow:.2f}%（与周期判断不一致）\")\n",
        "    \n",
        "    # 计算置信度等级\n",
        "    if confidence_score >= 4:\n",
        "        confidence_level = \"高\"\n",
        "        confidence_icon = \"🟢\"\n",
        "    elif confidence_score >= 3:\n",
        "        confidence_level = \"中\"\n",
        "        confidence_icon = \"🟡\"\n",
        "    else:\n",
        "        confidence_level = \"低\"\n",
        "        confidence_icon = \"🔴\"\n",
        "    \n",
        "    return {\n",
        "        'cycle': cycle,\n",
        "        'position': position,\n",
        "        'strategy': strategy,\n",
        "        'limit_up_count': limit_up_count,\n",
        "        'max_height': max_height,\n",
        "        'zhaban_rate': zhaban_rate,\n",
        "        'avg_inflow': avg_inflow,\n",
        "        'confidence_score': confidence_score,\n",
        "        'confidence_level': confidence_level,\n",
        "        'confidence_icon': confidence_icon,\n",
        "        'factors': factors\n",
        "    }\n",
        "\n",
        "# 判断当前市场情绪周期\n",
        "result = judge_emotion_cycle(limit_up_count, max_height, zhaban_rate, avg_inflow)\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"🎯 市场情绪周期判断结果（基于陈小群战法）\")\n",
        "print(\"=\" * 70)\n",
        "print()\n",
        "print(f\"📊 市场指标:\")\n",
        "print(f\"   涨停家数: {result['limit_up_count']}只\")\n",
        "print(f\"   最高连板: {result['max_height']}板\")\n",
        "print(f\"   炸板率: {result['zhaban_rate']:.2f}%\")\n",
        "print(f\"   资金净流入: {result['avg_inflow']:.2f}%\")\n",
        "print()\n",
        "print(f\"🎯 判断结果:\")\n",
        "print(f\"   情绪周期: {result['cycle']}\")\n",
        "print(f\"   建议仓位: {result['position']}\")\n",
        "print(f\"   推荐策略: {result['strategy']}\")\n",
        "print()\n",
        "print(f\"📈 判断依据:\")\n",
        "for factor in result['factors']:\n",
        "    print(f\"   • {factor}\")\n",
        "print()\n",
        "print(f\"🎯 置信度: {result['confidence_icon']} {result['confidence_level']} ({result['confidence_score']:.1f}/5.0)\")\n",
        "print()\n",
        "print(\"=\" * 70)"
      ]
    },
