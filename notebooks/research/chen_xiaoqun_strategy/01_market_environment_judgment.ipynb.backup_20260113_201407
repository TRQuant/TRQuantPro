        "import akshare as ak\n",
        "import pandas as pd\n",
        "from datetime import datetime, timedelta\n",
        "import numpy as np\n",
        "\n",
        "# 获取当前日期\n",
        "today = datetime.now()\n",
        "today_str = today.strftime('%Y%m%d')\n",
        "today_display = today.strftime('%Y-%m-%d')\n",
        "\n",
        "print(f\"📅 当前日期: {today_display}\")\n",
        "print()\n",
        "\n",
        "# 工具函数：将AKShare代码转换为JQData格式\n",
        "def convert_code_to_jq(code):\n",
        "    \"\"\"将AKShare股票代码转换为JQData格式\"\"\"\n",
        "    if not code:\n",
        "        return None\n",
        "    code_str = str(code)\n",
        "    if len(code_str) == 6:\n",
        "        if code_str.startswith('00') or code_str.startswith('30'):\n",
        "            return f\"{code_str}.XSHE\"  # 深市\n",
        "        elif code_str.startswith('60') or code_str.startswith('68'):\n",
        "            return f\"{code_str}.XSHG\"  # 沪市\n",
        "    return None\n",
        "\n",
        "# 获取涨停板数据\n",
        "print(\"📊 正在获取涨停板数据...\")\n",
        "try:\n",
        "    limit_up_data = ak.stock_zt_pool_em(date=today_str)\n",
        "    if limit_up_data is not None and not limit_up_data.empty:\n",
        "        limit_up_count = len(limit_up_data)\n",
        "        \n",
        "        # 添加JQData格式的代码列\n",
        "        limit_up_data['jq_code'] = limit_up_data['代码'].apply(convert_code_to_jq)\n",
        "        \n",
        "        # 过滤掉无法转换的代码\n",
        "        valid_data = limit_up_data[limit_up_data['jq_code'].notna()].copy()\n",
        "        \n",
        "        print(f\"✅ 获取成功！涨停家数: {limit_up_count}只\")\n",
        "        print(f\"✅ 有效代码: {len(valid_data)}只\")\n",
        "        \n",
        "        # 显示统计信息\n",
        "        print(f\"\\n📊 涨停板统计信息:\")\n",
        "        print(f\"   平均涨跌幅: {valid_data['涨跌幅'].mean():.2f}%\")\n",
        "        print(f\"   平均换手率: {valid_data['换手率'].mean():.2f}%\")\n",
        "        if '封板资金' in valid_data.columns:\n",
        "            print(f\"   总封板资金: {valid_data['封板资金'].sum()/100000000:.2f}亿元\")\n",
        "        \n",
        "        print(f\"\\n涨停股票列表（前60只）:\")\n",
        "        display_cols = ['代码', '名称', '最新价', '涨跌幅']\n",
        "        if '换手率' in valid_data.columns:\n",
        "            display_cols.append('换手率')\n",
        "        if '封板资金' in valid_data.columns:\n",
        "            display_cols.append('封板资金')\n",
        "        if '首次封板时间' in valid_data.columns:\n",
        "            display_cols.append('首次封板时间')\n",
        "        \n",
        "        print(valid_data[display_cols].head(60).to_string(index=False))\n",
        "        \n",
        "        limit_up_data = valid_data  # 使用处理后的数据\n",
