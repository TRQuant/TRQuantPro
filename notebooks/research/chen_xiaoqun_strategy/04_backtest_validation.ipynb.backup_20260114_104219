        "def judge_emotion_cycle(limit_up_count: int, zhaban_rate: float, max_height: int) -> Dict:\n",
        "    \"\"\"\n",
        "    根据市场指标判断情绪周期\n",
        "    \n",
        "    Args:\n",
        "        limit_up_count: 涨停家数\n",
